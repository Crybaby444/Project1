{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "WEB_ORIGIN"
      ]
    },
    "e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "env": [
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "WEB_ORIGIN"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
    "CI"
  ]
}
