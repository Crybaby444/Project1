{
  "name": "@yoyo/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure business rules of Yoyo: money, prices, calendar days, the booking state machine and the wallet ledger",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@yoyo/shared": "workspace:*"
  }
}
