# Copy to .env.local for local development (never commit .env.local).
# NEXT_PUBLIC_* values are baked in at build time.

# API origin; generated client paths already start with /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Show /styleguide (true locally and in CI e2e; false in production).
NEXT_PUBLIC_SHOW_STYLEGUIDE=true

# Server-only (never NEXT_PUBLIC_). The /api proxy sends it to the API in x-yoyo-proxy-secret; the same
# value as PROXY_SECRET on Render. Leave empty locally.
PROXY_SECRET=

# Server-only, read at build time. With both set, the legacy hosts redirect permanently to SITE_ORIGIN
# (production: SITE_ORIGIN=https://yoyo.rent, LEGACY_HOSTS=yoyo-rent.vercel.app). Leave empty locally.
SITE_ORIGIN=
LEGACY_HOSTS=
