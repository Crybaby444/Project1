# Copy to .env.local for local development (never commit .env.local).
# NEXT_PUBLIC_* values are baked in at build time.

# API origin; generated client paths already start with /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Show /styleguide (true locally and in CI e2e; false in production).
NEXT_PUBLIC_SHOW_STYLEGUIDE=true
