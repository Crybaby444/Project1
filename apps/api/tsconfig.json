{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // node20: CommonJS output that may require() ESM-only packages (jose), as Node >= 20.19 does.
    "module": "node20",
    "moduleResolution": "node16",
    "target": "ES2023",
    "outDir": "dist",
    // Email templates are React components (react-email).
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src", "test", "prisma", "prisma.config.ts", "vitest.config.mts"]
}
