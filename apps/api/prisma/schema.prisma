// Yoyo database schema. Connection settings live in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Emit `.js` import specifiers so the compiled dist/ output resolves under Node.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Runtime-adjustable settings (deadlines, fee %). A missing row means the default from @yoyo/shared applies.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
