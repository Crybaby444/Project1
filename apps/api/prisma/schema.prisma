generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Runtime settings editable by admins; defaults live in @yoyo/shared SETTING_DEFAULTS.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
