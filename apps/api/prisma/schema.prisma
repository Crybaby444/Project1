// Yoyo database schema. Connection settings live in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Emit `.js` import specifiers so the compiled dist/ output resolves under Node.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Runtime-adjustable settings (deadlines, fee %). A missing row means the default from @yoyo/shared applies.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// An account. Soft-deleted accounts keep their row (deletedAt) with personal data wiped.
model User {
  id              String    @id @default(cuid())
  /// Always trimmed and lowercase (also enforced by the CHECK constraint User_email_lowercase).
  email           String    @unique
  /// argon2id; null for accounts that only sign in with Google.
  passwordHash    String?
  name            String
  city            String?
  about           String?
  /// Interface and email language: en | lv | ru.
  locale          String    @default("en")
  /// Theme preference: system | light | dark.
  theme           String    @default("system")
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  /// The verified phone number (E.164); set only once a code confirmed it.
  phone           String?
  phoneVerifiedAt DateTime?
  blockedAt       DateTime?
  blockedReason   String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  emailTokens      EmailToken[]
  oauthAccounts    OAuthAccount[]
  phoneCodes       PhoneCode[]
  listings         Listing[]      @relation("ListingOwner")
  reviewedListings Listing[]      @relation("ListingReviewer")
  rentals          Booking[]      @relation("BookingRenter")
  lendings         Booking[]      @relation("BookingOwner")
  offersMade       Offer[]        @relation("OfferRenter")
  offersReceived   Offer[]        @relation("OfferOwner")
  payments         Payment[]
  payouts          Payout[]
  favorites        Favorite[]
}

/// One refresh token of a session. Rotation chains tokens of the same family; reuse revokes the family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Single-use email link (verify email, reset password).
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  /// SHA-256 of the token from the link.
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An external sign-in identity (e.g. Google `sub`) linked to a user.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// A one-time code sent to confirm a phone number.
model PhoneCode {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  /// Keyed hash of the 6-digit code.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sticker colours of DESIGN.md (STICKER_COLORS in @yoyo/shared).
enum Sticker {
  blue
  mint
  lavender
  ember
  sun
  violet
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

/// The category tree. Reference data from src/categories/catalog-data.ts, kept in sync on every start
/// (ensureCategories); a category that leaves the catalog is deactivated, never deleted.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  parentId  String?
  sortOrder Int      @default(0)
  sticker   Sticker
  /// Icon name the site maps to a drawing.
  icon      String
  /// { en, lv, ru }
  names     Json
  /// The category's address on each language's site, { en, lv, ru } (`/c/tools`, `/lv/c/instrumenti`).
  /// `slug` stays the stable key; these may change with the sitemap. Written by ensureCategories.
  slugs     Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  listings   Listing[]

  @@index([parentId])
}

/// A field the listing builder asks for in a category (spec §4.8).
model CategoryAttribute {
  id         String        @id @default(cuid())
  categoryId String
  key        String
  type       AttributeType
  required   Boolean       @default(false)
  /// Unit symbol for numbers (`W`, `m`, `kg`).
  unit       String?
  /// { en, lv, ru }
  labels     Json
  /// SELECT only: [{ value, labels: { en, lv, ru } }]
  options    Json?
  sortOrder  Int           @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

/// An item for rent. Status changes only by the table in src/listings/listing-status.ts. The exact
/// point (lat, lng) is shown to the owner and administrators only; everyone else sees the district.
model Listing {
  id                    String            @id @default(cuid())
  ownerId               String
  categoryId            String?
  status                ListingStatus     @default(DRAFT)
  title                 String?
  description           String?
  condition             ListingCondition?
  /// Values by CategoryAttribute.key, checked against the category's definitions.
  attributes            Json              @default("{}")
  dailyCents            Int?
  weeklyDiscountPercent Int               @default(0)
  depositCents          Int               @default(0)
  minDays               Int               @default(1)
  maxDays               Int               @default(30)
  city                  String?
  district              String?
  lat                   Decimal?          @db.Decimal(9, 6)
  lng                   Decimal?          @db.Decimal(9, 6)
  timeZone              String            @default("Europe/Riga")
  /// The language the owner wrote the texts in (en | lv | ru): the item's canonical address and its
  /// <html lang> use it. A term, not content: changing it does not send the listing back to review.
  contentLocale         String            @default("en")
  /// { preset: RulePreset[], custom: string[] }
  rules                 Json              @default("{\"preset\":[],\"custom\":[]}")
  /// Why moderation rejected it; shown to the owner.
  rejectionReason       String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  /// When it was first published; a listing that was never public may be deleted for good.
  publishedAt           DateTime?
  /// Counts every change; a PATCH with an older version is refused (optimistic locking).
  version               Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  owner          User             @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("ListingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos         ListingPhoto[]
  unavailability Unavailability[]
  bookings       Booking[]
  offers         Offer[]
  favoritedBy    Favorite[]

  @@index([ownerId])
  @@index([status, categoryId])
  /// The catalog's default order. Trigram indexes on yoyo_fold(title…) live in migration `catalog` only.
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)], map: "Listing_catalog_idx")
}

/// A photo of a listing; the file lives in the storage provider under `storageKey` (random, never the
/// user's file name). Position 0 is the cover.
model ListingPhoto {
  id         String   @id @default(cuid())
  listingId  String
  storageKey String   @unique
  width      Int
  height     Int
  bytes      Int
  format     String
  position   Int
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

/// Days the owner closed: from `start` to `end`, both included, in the listing's time zone.
model Unavailability {
  id        String   @id @default(cuid())
  listingId String
  start     DateTime @db.Date
  end       DateTime @db.Date

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

/// An item someone keeps an eye on (spec §4.2 "Favourites"). Adding twice is one row; it goes with
/// the user or the listing.
model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

/// Geocoder answers (Nominatim), kept 30 days: the same search never asks it twice.
model GeoCache {
  /// `search:<lang>:<normalized query>` or `reverse:<lang>:<lat>,<lng>`
  key       String   @id
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- Deals and wallet (plan 8) ------------------------------------------------------------------

/** BOOKING_STATUSES of @yoyo/domain. */
enum BookingStatus {
  REQUESTED
  ACCEPTED
  PAID
  ACTIVE
  RETURNED
  DAMAGE_CLAIMED
  DISPUTED
  COMPLETED
  DECLINED
  EXPIRED
  CANCELLED
}

/** TIMER_KINDS of @yoyo/domain. */
enum TimerKind {
  REQUEST_EXPIRY
  PAYMENT_EXPIRY
  HANDOVER_DEADLINE
  HANDOVER_CONFIRM
  RETURN_CONFIRM
  INSPECTION
  DAMAGE_REPLY
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PriceSource {
  LISTED
  AGREED
}

enum DisputeReason {
  DAMAGE
  NOT_RETURNED
  NOT_HANDED_OVER
}

enum ResolveDecision {
  REFUND_DEPOSIT
  DEPOSIT_TO_OWNER
  REFUND_ALL
  CONFIRM_HANDOVER
}

enum BookingOutcome {
  DEPOSIT_REFUNDED
  DEPOSIT_TO_OWNER
  REFUNDED_ALL
}

enum CancelledBy {
  RENTER
  OWNER
  ADMIN
}

/**
 * A deal: the snapshot @yoyo/domain decides on, column by column. Only the API's BookingsService
 * writes it, after `decide()`. `reserved` holds the rental days while they are taken; the exclusion
 * constraint Booking_no_double_booking (migration `deals`) makes a second overlapping reservation of the
 * same listing impossible. At most one timer is armed: `timerKind` due at `timerDueAt`.
 */
model Booking {
  id                  String                    @id @default(cuid())
  listingId           String
  renterId            String
  ownerId             String
  offerId             String?                   @unique
  status              BookingStatus
  /// First and last rental day, both included, in `timeZone`.
  start               DateTime                  @db.Date
  end                 DateTime                  @db.Date
  timeZone            String
  /// The renter's note to the owner.
  message             String?
  days                Int
  dailyCents          Int
  baseCents           Int
  discountPercent     Int
  discountCents       Int
  rentCents           Int
  serviceFeeCents     Int
  depositCents        Int
  totalCents          Int
  ownerPayoutCents    Int
  priceSource         PriceSource
  renterSignedAt      DateTime?
  ownerSignedAt       DateTime?
  paymentMethod       PaymentMethod?
  ownerHandedOverAt   DateTime?
  renterReceivedAt    DateTime?
  renterReturnedAt    DateTime?
  ownerReceivedBackAt DateTime?
  declineReason       String?
  damageDescription   String?
  damagePhotoIds      String[]                  @default([])
  damageClaimedAt     DateTime?
  disputeReason       DisputeReason?
  disputeOpenedAt     DateTime?
  disputeNote         String?
  resolutionDecision  ResolveDecision?
  resolutionComment   String?
  resolvedById        String?
  resolvedAt          DateTime?
  outcome             BookingOutcome?
  cancelledBy         CancelledBy?
  cancelReason        String?
  cancelledAt         DateTime?
  timerKind           TimerKind?
  timerDueAt          DateTime?
  /// daterange of the taken days while reserved (RESERVE_DATES … RELEASE_DATES); written with raw SQL.
  reserved            Unsupported("daterange")?
  /// Counts every change; an action with an older version is refused (optimistic locking).
  version             Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  completedAt         DateTime?

  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  renter   User           @relation("BookingRenter", fields: [renterId], references: [id], onDelete: Restrict)
  owner    User           @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  offer    Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  events   BookingEvent[]
  contract Contract?
  photos   BookingPhoto[]
  payments Payment[]

  @@index([renterId, updatedAt])
  @@index([ownerId, updatedAt])
  @@index([listingId])
  @@index([timerDueAt])
  @@index([status])
}

/** Every change of a booking, never edited: who did what, from which status to which. */
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  /// The domain event (`ACCEPT`, `TIMEOUT`…) or `REQUEST` for the first one.
  type       String
  /// RENTER | OWNER | ADMIN | SYSTEM
  actorKind  String
  actorId    String?
  fromStatus BookingStatus?
  toStatus   BookingStatus
  /// The event's data (reason, note, timer…), never card details.
  data       Json           @default("{}")
  /// SYSTEM_MESSAGE templates for the chat (plan 9).
  messages   String[]       @default([])
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

/** The rental contract's terms, frozen when the owner accepts; the PDF is drawn from them in any language. */
model Contract {
  bookingId String   @id
  terms     Json
  /// sha256 of the canonical JSON of `terms`; printed on the PDF.
  termsHash String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum BookingPhotoKind {
  HANDOVER
  RETURN
  DAMAGE
}

/** A photo of the item's condition at handover, at return, or of damage (spec §6 HandoverPhoto). */
model BookingPhoto {
  id         String           @id @default(cuid())
  bookingId  String
  uploaderId String
  kind       BookingPhotoKind
  storageKey String           @unique
  width      Int
  height     Int
  bytes      Int
  format     String
  createdAt  DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, kind])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
  USED
}

/** A renter's own daily price for given days (spec §4.6); an accepted one is used by one booking request. */
model Offer {
  id         String      @id @default(cuid())
  listingId  String
  renterId   String
  ownerId    String
  start      DateTime    @db.Date
  end        DateTime    @db.Date
  dailyCents Int
  status     OfferStatus @default(PENDING)
  expiresAt  DateTime
  answeredAt DateTime?
  createdAt  DateTime    @default(now())

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renter  User     @relation("OfferRenter", fields: [renterId], references: [id], onDelete: Cascade)
  owner   User     @relation("OfferOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([renterId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
}

/** OperationKind of @yoyo/domain. */
enum LedgerKind {
  TOP_UP
  WITHDRAWAL
  BOOKING_PAYMENT
  RENT_RELEASE
  DEPOSIT_REFUND
  DEPOSIT_TO_OWNER
  BOOKING_REFUND
}

/**
 * One journal entry of the double-entry ledger. Its postings (LedgerEntry) sum to zero: a deferred
 * constraint trigger checks that at commit. Neither is ever changed or deleted.
 */
model LedgerOperation {
  id        String     @id @default(cuid())
  kind      LedgerKind
  bookingId String?
  /// Whose wallet operation it is (top-ups and payouts).
  userId    String?
  createdAt DateTime   @default(now())

  entries LedgerEntry[]
  payout  Payout?

  @@index([bookingId])
  @@index([createdAt])
}

/** A posting: whole cents into (+) or out of (−) an account (`wallet:<userId>`, `escrow:<bookingId>`…). */
model LedgerEntry {
  id          BigInt @id @default(autoincrement())
  operationId String
  account     String
  amount      Int

  operation LedgerOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([account, id])
  @@index([operationId])
}

/**
 * The balance of an account: a cache of the sum of its postings, written in the same transaction
 * (spec §6 Wallet for `wallet:` accounts). Wallets, escrow and deposits never go below zero (CHECK).
 */
model LedgerAccount {
  id        String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum PaymentPurpose {
  BOOKING
  TOP_UP
}

enum MoneyJobStatus {
  PENDING
  DONE
  FAILED
}

/** Money taken from a card through the PaymentProvider. Only the brand and last 4 digits are kept. */
model Payment {
  id            String         @id @default(cuid())
  userId        String
  bookingId     String?
  purpose       PaymentPurpose
  amountCents   Int
  refundedCents Int            @default(0)
  providerRef   String         @unique
  brand         String
  last4         String
  createdAt     DateTime       @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds PaymentRefund[]

  @@index([userId, createdAt])
  @@index([bookingId])
}

/** Money going back to a card. Written with the ledger operation, sent to the provider after commit. */
model PaymentRefund {
  id          String         @id @default(cuid())
  paymentId   String
  amountCents Int
  status      MoneyJobStatus @default(PENDING)
  providerRef String?
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  doneAt      DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

/** A withdrawal to a card (spec §6 Payout): the wallet is debited at once, the provider pays out after. */
model Payout {
  id               String         @id @default(cuid())
  userId           String
  amountCents      Int
  brand            String
  last4            String
  /// The provider's token of the destination card (never the card number).
  destinationToken String
  status           MoneyJobStatus @default(PENDING)
  providerRef      String?
  attempts         Int            @default(0)
  lastError        String?
  operationId      String         @unique
  createdAt        DateTime       @default(now())
  doneAt           DateTime?

  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  operation LedgerOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum IdempotencyState {
  IN_PROGRESS
  DONE
}

/** A client's Idempotency-Key and the answer it got, kept 24 hours; the same request again gets that answer. */
model IdempotencyKey {
  userId      String
  key         String
  /// `POST /api/v1/wallet/top-ups`
  scope       String
  /// sha256 of scope and body: the same key with another request is refused.
  requestHash String
  state       IdempotencyState @default(IN_PROGRESS)
  statusCode  Int?
  body        Json?
  createdAt   DateTime         @default(now())

  @@id([userId, key])
  @@index([createdAt])
}
