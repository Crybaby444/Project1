{
  "name": "@yoyo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Yoyo REST + realtime API (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "openapi:emit": "nest build && node dist/scripts/emit-openapi.js",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "start:migrate": "prisma migrate deploy && node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@yoyo/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/react": "19.3.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
