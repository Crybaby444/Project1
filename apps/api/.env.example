# Copy to .env for local development (never commit .env).
DATABASE_URL=postgresql://yoyo:yoyo@localhost:5432/yoyo_dev
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Reverse proxies in front of the API (0 locally; 2 on Render: its load balancer + the Vercel proxy).
TRUST_PROXY_HOPS=0

# Signs access tokens; at least 32 characters. Locally any long random string, e.g. `openssl rand -base64 32`.
# In production Render generates it (render.yaml).
JWT_SECRET=change-me-to-a-long-random-local-secret

# Outgoing mail. Locally Mailpit catches everything (see http://localhost:8025); this is also the default.
# Production without SMTP_URL sends no mail at all ("mail disabled" in the log).
SMTP_URL=smtp://localhost:1025
# Sender. With Gmail SMTP it must be that Gmail address, e.g. Yoyo <you@gmail.com>.
MAIL_FROM=Yoyo <no-reply@yoyo.local>

# Sign in with Google: on only when both are set (Google Cloud Console → Credentials → OAuth client ID,
# type "Web application", redirect URI http://localhost:3000/api/v1/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
