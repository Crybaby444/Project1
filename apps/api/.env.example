# Copy to .env for local development (never commit .env).
DATABASE_URL=postgresql://yoyo:yoyo@localhost:5432/yoyo_dev
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Reverse proxies in front of the API (0 locally; 2 on Render: its load balancer + the Vercel proxy).
TRUST_PROXY_HOPS=0

# Optional, at least 32 characters; the same value as PROXY_SECRET of the site (apps/web). When set,
# X-Forwarded-For is trusted only on requests that carry it in x-yoyo-proxy-secret (the site proxy).
# Leave empty locally.
PROXY_SECRET=

# Registrations per hour from all addresses together (default 100).
REGISTRATION_HOURLY_CAP=100

# Signs access tokens; at least 32 characters. Locally any long random string, e.g. `openssl rand -base64 32`.
# In production Render generates it (render.yaml).
JWT_SECRET=change-me-to-a-long-random-local-secret

# Outgoing mail. Locally Mailpit catches everything (see http://localhost:8025); this is also the default.
# Production without SMTP_URL sends no mail at all ("mail disabled" in the log).
SMTP_URL=smtp://localhost:1025
# Production uses Resend: SMTP_URL=smtps://resend:<API_KEY>@smtp.resend.com:2465 (port 2465: Render's
# free tier blocks 25, 465 and 587).
# Sender, on a domain the mail service verified; in production Yoyo <no-reply@yoyo.rent>.
MAIL_FROM=Yoyo <no-reply@yoyo.local>
# Emails per 24 hours from the whole API; over it mail is skipped (default 90, under Resend's free 100).
MAIL_DAILY_LIMIT=90

# Sign in with Google: on only when both are set (Google Cloud Console → Credentials → OAuth client ID,
# type "Web application", redirect URI http://localhost:3000/api/v1/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone confirmation codes. `mailbox` (the default outside production) emails the code instead of
# texting it, so you can read it in Mailpit. Production refuses `mailbox`; with no provider the
# phone endpoints answer 404 until a real SMS service is added.
SMS_PROVIDER=mailbox

# Administrator account: created (or promoted) on every API start and by `db:seed` when both are set.
# A confirmed account keeps its own password; an unconfirmed one with this email is taken over
# (password ADMIN_PASSWORD, its sessions and links deleted), so nobody can pre-register it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Listing photos: `local` keeps them in apps/api/.uploads (the default outside production); production
# uses `cloudinary` with CLOUDINARY_URL from the Cloudinary console (Settings → API Keys). Without a
# storage the API still runs and photo uploads answer 503 STORAGE_DISABLED.
STORAGE=local
UPLOADS_DIR=.uploads
CLOUDINARY_URL=

# Address search (OpenStreetMap Nominatim): at most 1 request a second, answers cached 30 days.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Payments: `fake` is the test card provider (the only one for now; no real money moves).
PAYMENTS=fake

# Service fee renters pay, in percent of the rent, and its launch offer (owner decision of 2026-11-06:
# 0 % for the first 3 months after the public launch, then 10 %). FEE_PROMO_UNTIL is the offer's last
# day (YYYY-MM-DD, where the item is); empty: no offer. Rows fees.servicePercent, fees.promoServicePercent
# and fees.promoServiceUntil in the Setting table override these at runtime. Every booking keeps the fee
# it was requested with.
FEE_PERCENT=10
FEE_PROMO_PERCENT=0
FEE_PROMO_UNTIL=

# Protects POST /api/v1/internal/timers/run (deal deadlines), at least 32 characters. Empty locally: the
# route does not exist and deadlines fire when the API starts. Run them by hand with any long value:
#   curl -X POST localhost:4000/api/v1/internal/timers/run -H "Authorization: Bearer $TIMERS_SECRET"
TIMERS_SECRET=
